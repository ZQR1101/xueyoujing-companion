# 学有所径 - 环境配置样例（复制为 .env 后按需修改；.env 不提交）
# 字段名以规格书为准，属拟定方案，在 T01/T07 实施时最终确定。

# ---- 服务 ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_DEV_URL=http://localhost:5174

# ---- 数据 ----
# SQLite 为唯一事实源；路径相对项目根目录
DATABASE_URL=sqlite:///./data/app.db
# 复习间隔基线（天），规格书 §7.2 可配置基线
REVIEW_INTERVAL_DAYS=1

# ---- LLM 网关（规格书 §5/§14）----
# provider：mock = 离线模拟提供者（默认，决策轨迹标 model_id=mock）；
#           openai = 任意 OpenAI 兼容 /chat/completions 接口。
# 启用真实模型：填好下面三项后把 LLM_PROVIDER 改为 openai。
#
# DeepSeek（V4-Flash）示例：
#   LLM_BASE_URL=https://api.deepseek.com   （网关自动拼接 /chat/completions，末尾不要带 /v1）
#   LLM_MODEL_ID=deepseek-v4-flash          （快照版可用 deepseek-v4-flash-0731）
#   密钥在 https://platform.deepseek.com 申请
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_ID=deepseek-v4-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# ---- 演示令牌（本地演示能力，不是公网认证系统，见规格书 §6）----
DEMO_TOKEN_SECRET=change-me-in-local-env